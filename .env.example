# Copy this file to ".env" and adjust the values for your environment.

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------- DB
DB_NAME=elearning_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------------------------------- Email
# For local testing without SMTP, set EMAIL_BACKEND to:
#   django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=you@gmail.com

# Recipient of admin notifications (contact form, etc.)
ADMIN_EMAIL=you@gmail.com

# Public base URL used in email links, e.g. "https://www.elearning.com"
# (leave empty in local development to fall back to the request host)
SITE_URL=

# ----------------------------------------------------------------- Stripe
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret for the checkout.session.completed event.
# Create the endpoint in https://dashboard.stripe.com/test/webhooks
# pointing to  https://<your-domain>/stripe/webhook/  and paste the
# "whsec_..." value here. While empty, the webhook stays inactive and the
# receipt email is sent from the payment-success page instead.
STRIPE_WEBHOOK_SECRET=